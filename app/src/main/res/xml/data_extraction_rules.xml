<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 (API 31) and higher.
    Mirrors backup_rules.xml (used on API 30 and lower); see that file for the reasons.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="episodes" />
        <exclude domain="file" path="sherpa-onnx-whisper-tiny.en" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="episodes" />
        <exclude domain="file" path="sherpa-onnx-whisper-tiny.en" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
